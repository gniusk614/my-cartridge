                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              },
              "move": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              },
              "attack": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              },
              "jump": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              },
              "crouch": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              },
              "hurt": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              },
              "down": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "row",
                  "frames",
                  "fps"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "idle",
              "move",
              "attack"
            ],
            "additionalProperties": false
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "display_height": {
