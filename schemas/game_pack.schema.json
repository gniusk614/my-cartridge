              "type": "object",
              "properties": {
                "character_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 24,
                      "maximum": 1896
                    },
                    "y": {
                      "type": "number",
                      "minimum": 104,
                      "maximum": 156
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "character_id",
                "position",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 16
          },
          "background_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "palette": {
            "type": "object",
            "properties": {
              "sky": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "ground": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "building": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "props": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "asset_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1920
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 180
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "width": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 256
                },
                "height": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 180
                },
                "layer": {
                  "type": "string",
                  "enum": [
                    "behind",
                    "front"
                  ]
                },
                "flip_x": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "position",
                "width",
                "height",
                "layer",
                "flip_x"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "theme",
          "width",
          "spawn",
          "door",
          "surfaces",
          "npcs"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "portrait",
              "sprite_sheet",
              "background",
              "prop",
              "character_source"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048
          },
          "png_base64": {
            "type": "string",
            "minLength": 32,
            "maxLength": 2000000,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          },
          "frame_width": {
            "type": "integer",
            "minimum": 8,
            "maximum": 128
          },
          "frame_height": {
            "type": "integer",
            "minimum": 8,
            "maximum": 128
          },
          "animations": {
            "type": "object",
            "properties": {
              "idle": {
                "type": "object",
