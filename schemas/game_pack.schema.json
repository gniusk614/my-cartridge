          "id",
          "title",
          "intro",
          "template",
          "mechanics",
          "enemies",
          "objectives"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "ending": {
      "type": "object",
      "properties": {
        "letter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "music_asset_key": {
          "type": "string",
          "enum": [
            "demo_ending"
          ]
        }
      },
      "required": [
        "letter",
        "music_asset_key"
      ],
      "additionalProperties": false
    },
    "coop": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "theme": {
            "type": "string",
            "enum": [
              "winter_street",
              "garden",
              "sunset"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 640,
            "maximum": 1920
          },
          "spawn": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 24,
                "maximum": 1896
              },
              "y": {
                "type": "number",
                "minimum": 104,
                "maximum": 156
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "door": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 24,
                "maximum": 1896
              },
              "y": {
                "type": "number",
                "minimum": 104,
                "maximum": 156
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "x": {
                  "type": "number",
                  "minimum": 24,
                  "maximum": 1896
                },
                "y": {
                  "type": "number",
                  "minimum": 104,
                  "maximum": 148
                },
                "width": {
                  "type": "number",
                  "minimum": 8,
                  "maximum": 512
                },
                "depth": {
                  "type": "number",
                  "minimum": 8,
                  "maximum": 52
